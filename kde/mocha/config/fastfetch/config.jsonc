// fastfetch — kde-mocha-rice (cores Catppuccin Mocha)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "left": 2, "right": 4 },
    "color": { "1": "#cba6f7", "2": "#f5c2e7" }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#cba6f7", "title": "#f5c2e7", "separator": "#6c7086" },
    "key": { "width": 14 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;69;71;90m────────────────────────────────────" },
    { "type": "os",       "key": "󰣇  sistema" },
    { "type": "kernel",   "key": "  kernel" },
    { "type": "uptime",   "key": "󰅐  ligado há" },
    { "type": "packages", "key": "󰏖  pacotes" },
    { "type": "de",       "key": "  desktop" },
    { "type": "wm",       "key": "  janelas" },
    { "type": "theme",    "key": "󰉼  tema" },
    { "type": "icons",    "key": "  ícones" },
    { "type": "font",     "key": "  fonte" },
    { "type": "terminal", "key": "  terminal" },
    { "type": "shell",    "key": "  shell" },
    { "type": "cpu",      "key": "  cpu" },
    { "type": "gpu",      "key": "󰍛  gpu" },
    { "type": "memory",   "key": "  memória" },
    { "type": "disk",     "key": "󰋊  disco", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
